# GEMINI_API_KEY: Required for optional remote Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DocuLens Configuration
DOCULENS_ENV="development"
DOCULENS_DATA_DIR="./data"
DOCULENS_MAX_UPLOAD_MB="25"
DOCULENS_MAX_PAGES="250"
DOCULENS_PARSER_TIMEOUT_SECONDS="120"
DOCULENS_REMOTE_AI_ENABLED="false"

